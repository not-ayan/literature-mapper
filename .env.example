# Google Gemini API Key for literature synthesis and claim extraction
# Get an API key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ScraperAPI / Scholar API Key for Google Scholar queries and gated paper PDF downloads
# (Either SCRAPER_API_KEY or SCHOLAR_API_KEY works)
# Get a key at: https://www.scraperapi.com/
SCRAPER_API_KEY=your_scraperapi_key_here
SCHOLAR_API_KEY=


# (Optional) Model configurations
LITMAP_GEN_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=BAAI/bge-m3
CONFIDENCE_THRESHOLD=0.60

